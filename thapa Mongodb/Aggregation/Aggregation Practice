Q8
Find the employee who has the largest number of projects. If multiple employees are tied, return all of them.

db.employees.aggregate([{$lookup:{from:"projects",localField:"_id",foreignField:"employeeId",as:"projectsData"}},{$addFields:{projectCount:{$size:"$projectsData"}}},{$group:{_id:null,maxCount:{$max:"$projectCount"},allEmployees:{$push:"$$ROOT"}}},{$addFields:{employeeInfo:{$filter:{input:"$allEmployees",as:"employee",cond:{$eq:["$$employee.projectCount","$maxCount"]}}}}},{$unwind:"$employeeInfo"},{$project:{_id:0,employeeName:"$employeeInfo.name",projectCount:"$employeeInfo.projectCount"}}])

or

db.employees.aggregate([
  {
    $lookup: {
      from: "projects",
      localField: "_id",
      foreignField: "employeeId",
      as: "projectsData"
    }
  },
  {
    $addFields: {
      projectCount: { $size: "$projectsData" }
    }
  },
  {
    $group: {
      _id: null,
      maxProjects: { $max: "$projectCount" },
      allEmployees: { $push: "$$ROOT" }
    }
  },
  {
    $project: {
      employees: {
        $filter: {
          input: "$allEmployees",
          as: "employee",
          cond: {
            $eq: ["$$employee.projectCount", "$maxProjects"]
          }
        }
      }
    }
  },
  {
    $unwind: "$employees"
  },
  {
    $project: {
      _id: 0,
      employeeName: "$employees.name",
      projectCount: "$employees.projectCount"
    }
  }
])


