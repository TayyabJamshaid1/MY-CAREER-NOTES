import "./App.css";
import * as Header from "./Header";
import Footer from "./Footer";
import {createBrowserRouter, Outlet, RouterProvider} from "react-router-dom"
import Error from "./Components/Error";
import ShimmerComponent from "./ShimmerComponent";
import { lazy, Suspense } from "react";

// Lazy load all components
const Body = lazy(() => import("./Body"));
const AboutComponent = lazy(() => import("./Components/AboutComponent"));
const ContactComponent = lazy(() => import("./Components/ContactComponent"));
const RestaurantMenu = lazy(() => import("./Components/RestaurantMenu"));
const ProfileComponent = lazy(() => import("./Components/ProfileComponent"));
const Instamart = lazy(() => import("./Components/Instamart"));

const AppLayout=()=>{
    return(
      <>
      <Header.Header/>
      <Suspense fallback={<ShimmerComponent/>}>
        <Outlet/>
      </Suspense>
      <Footer/>
      </>
    )
}

const App = () => {
  const AppProvider=createBrowserRouter([
    {
      path:"/",
      element:<AppLayout/>,
      errorElement:<Error/>,
      children:[
        {
          path:"/",
          element:<Body/>
        },
        {
          path:"/about",
          element:<AboutComponent/>,
          children:[{
            path:"profile",
            element:<ProfileComponent/>
          }]
        },
        {
          path:"/contact",
          element:<ContactComponent/>
        },
        {
          path:"/restaurantMenu/:id",
          element:<RestaurantMenu/>
        },
        {
          path:"/instamart",
          element:<Instamart/>
        }
      ]
    }
  ])
  
  return (
    <>
    <RouterProvider router={AppProvider}/>
    </>
  );
};

export default App;

Important notes:

The Header and Footer components are not lazy-loaded because they're needed immediately on all routes

The Error component is not lazy-loaded because it needs to be available immediately if there's a routing error

You might want to create different loading states for different components rather than using the same ShimmerComponent everywhere

Make sure all your lazy-loaded components have a default export (the lazy() function requires this)


