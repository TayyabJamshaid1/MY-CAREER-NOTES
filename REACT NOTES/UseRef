2-To access or update the directly dom elements
import { useEffect, useRef, useState } from "react";

const Body = () => {
  const [count, setCount] = useState(0);
  let val = useRef();
  const incrementCount = () => {
    setCount((count) => count + 1);
  };
  const changeColor = () => {
    val.current.style.backgroundColor = "red";
  };
  return (
    <>
      <h1>{count} Parent</h1>
      <br />
      <br />
      <button onClick={incrementCount} ref={val}>
        Increment Count
      </button>

      <br />
      <br />
      <button onClick={changeColor}>Change Increment background color</button>
    </>
  );
};
export default Body;

