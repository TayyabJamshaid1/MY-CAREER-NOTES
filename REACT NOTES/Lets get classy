componentWillUnmount()
It is used for "CLEAN UP"
It will be called when your component is out of dom ui/or when we are leaving the page.

=>I am sharing a use case scenario of componentWillUnmount in which let supposse ,i started a interval and move to another component,that interval still runs.It should stop.To stop it,we can call clear interval in componentWillUnmount.
import React from "react";

class ProfileComponent extends React.Component {
    constructor(props){
        super(props);
       
        console.log('child constructor called '+this.props.userName);
    }
   async componentDidMount(){
    this.timer=setInterval(()=>{
      console.log('called');
      
    },1000)
    
        console.log('child componentDidMount end ' + this.props.userName)
    }

    componentDidUpdate(){
        console.log('componentDidUpdate called'); 
    }
    componentWillUnmount(){
      clearInterval(this.timer)
    }
  render() {
    return (
      <div>
        ProfileComponent
        
      </div>
    );
  }
}
export default ProfileComponent;

