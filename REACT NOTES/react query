import React from "react";
import { useQuery, useQueries } from "@tanstack/react-query";

const Parallel = () => {
  const [userIds, setUserIds] = React.useState([1, 2]);

  userIds.forEach((id) => {
    const data = useQuery({
      queryKey: ["userId", id],
      queryFn: async () => {
        const data = await fetch(`https://dummyjson.com/users/${id}`).then(
          (res) => res.json()
        );

        return data;
      },
    });
    console.log(data.data);
  });

  return (
    <div>
      <button
        onClick={() =>
          setUserIds((prev) => {
            return [...prev, Date.now()];
          })
        }
      >
        Load more
      </button>

      {userIds.map((id) => (
        <h1 key={id}>{id}</h1>
      ))}
    </div>
  );
};

export default Parallel;

